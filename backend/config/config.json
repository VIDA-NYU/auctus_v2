{
  "active_providers": ["socrata", "ckan"],
  "providers": {
    "socrata": {
      "strategy": "DYNAMIC",
      "registry_file": "socrata.json"
    },
    "ckan": {
      "strategy": "EXPLICIT",
      "domains": []
    },
    "invenio": {
      "strategy": "EXPLICIT",
      "domains": [
        "ultraviolet.library.nyu.edu",
        "zenodo.org",
        "data.caltech.edu"
      ],
      "max_datasets_per_domain": 100,
      "domain_settings": {
        "zenodo.org": {
          "page_size": 25,
          "query": "metadata.resource_type.id:dataset AND \"new york city\"",
          "max_datasets": 10,
          "label": "Zenodo"
        },
        "data.caltech.edu": {
          "max_datasets": 5000,
          "label": "CaltechDATA"
        },
        "ultraviolet.library.nyu.edu": {
          "max_datasets": 1000,
          "label": "NYU UltraViolet"
        }
      }
    }
  },
  "pipeline_settings": {
    "max_sample_rows": 500,
    "max_sample_bytes": 2100000,
    "http_timeout_seconds": 30.0,
    "development_safeguards": {
      "enabled": true,
      "max_domains_per_provider": 3,
      "max_datasets_per_domain": 4
    }
  }
}
